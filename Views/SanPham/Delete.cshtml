@model Quản_Lý_KhoHàng.Models.SanPham
@{ ViewData["Title"] = "Xóa sản phẩm"; }

<h1>Xóa sản phẩm</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<p>Bạn có chắc muốn xóa sản phẩm <strong>@Model.TenSanPham</strong>?</p>
<dl class="row"><dt class="col-sm-3">Danh mục</dt><dd class="col-sm-9">@Model.MaDanhMucNavigation.TenDanhMuc</dd><dt class="col-sm-3">Hãng sản xuất</dt><dd class="col-sm-9">@Model.MaHangNavigation.TenHang</dd></dl>
<form asp-action="Delete" asp-route-id="@Model.MaSanPham">
    <input type="hidden" asp-for="MaSanPham" />
    <button type="submit" class="btn btn-danger">Xóa</button> <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</form>
