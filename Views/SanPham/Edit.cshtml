@model Quản_Lý_KhoHàng.Models.SanPham
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = "Sửa sản phẩm"; var danhMucOptions = ViewData["MaDanhMuc"] as SelectList; var hangOptions = ViewData["MaHang"] as SelectList; }

<h1>Sửa sản phẩm</h1>
<hr />
<div class="row"><div class="col-md-6">
    <form asp-action="Edit" asp-route-id="@Model.MaSanPham">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="MaSanPham" />
        <div class="mb-3"><label asp-for="TenSanPham" class="form-label">Tên sản phẩm</label><input asp-for="TenSanPham" class="form-control" /><span asp-validation-for="TenSanPham" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="GiaBan" class="form-label">Giá bán</label><input asp-for="GiaBan" type="number" min="0" step="0.01" class="form-control" /><span asp-validation-for="GiaBan" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="SoLuongTon" class="form-label">Số lượng tồn</label><input asp-for="SoLuongTon" type="number" min="0" class="form-control" /><span asp-validation-for="SoLuongTon" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="TonKhoToiThieu" class="form-label">Tồn kho tối thiểu</label><input asp-for="TonKhoToiThieu" type="number" min="0" class="form-control" /><span asp-validation-for="TonKhoToiThieu" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MoTa" class="form-label">Mô tả</label><textarea asp-for="MoTa" class="form-control"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MaDanhMuc" class="form-label">Danh mục</label><select asp-for="MaDanhMuc" asp-items="danhMucOptions" class="form-select"><option value="">-- Chọn danh mục --</option></select><span asp-validation-for="MaDanhMuc" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MaHang" class="form-label">Hãng sản xuất</label><select asp-for="MaHang" asp-items="hangOptions" class="form-select"><option value="">-- Chọn hãng --</option></select><span asp-validation-for="MaHang" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }



