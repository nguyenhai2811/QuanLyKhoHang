@model IEnumerable<Quản_Lý_KhoHàng.Models.SanPham>
@{ ViewData["Title"] = "Sản phẩm"; }

<div class="d-flex justify-content-between align-items-center mb-3"><h1>Sản phẩm</h1><a asp-action="Create" class="btn btn-primary">Thêm sản phẩm</a></div>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Tên sản phẩm</th><th>Giá bán</th><th>Tồn kho</th><th>Tồn tối thiểu</th><th>Danh mục</th><th>Hãng sản xuất</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TenSanPham</td><td>@item.GiaBan.ToString("N0")</td><td>@item.SoLuongTon</td><td>@item.TonKhoToiThieu</td>
            <td>@item.MaDanhMucNavigation.TenDanhMuc</td><td>@item.MaHangNavigation.TenHang</td>
            <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.MaSanPham">Sửa</a> | <a asp-action="Details" asp-route-id="@item.MaSanPham">Chi tiết</a> | <a asp-action="Delete" asp-route-id="@item.MaSanPham">Xóa</a></td>
        </tr>
    }
    </tbody>
</table></div>
