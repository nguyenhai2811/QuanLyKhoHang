@model Quản_Lý_KhoHàng.Models.SanPham
@{ ViewData["Title"] = "Chi tiết sản phẩm"; }

<h1>Chi tiết sản phẩm</h1>
<dl class="row">
    <dt class="col-sm-3">Tên sản phẩm</dt><dd class="col-sm-9">@Model.TenSanPham</dd>
    <dt class="col-sm-3">Giá bán</dt><dd class="col-sm-9">@Model.GiaBan.ToString("N0")</dd>
    <dt class="col-sm-3">Số lượng tồn</dt><dd class="col-sm-9">@Model.SoLuongTon</dd>
    <dt class="col-sm-3">Tồn kho tối thiểu</dt><dd class="col-sm-9">@Model.TonKhoToiThieu</dd>
    <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.MoTa</dd>
    <dt class="col-sm-3">Danh mục</dt><dd class="col-sm-9">@Model.MaDanhMucNavigation.TenDanhMuc</dd>
    <dt class="col-sm-3">Hãng sản xuất</dt><dd class="col-sm-9">@Model.MaHangNavigation.TenHang</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.MaSanPham" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
