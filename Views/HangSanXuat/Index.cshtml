@model IEnumerable<Quản_Lý_KhoHàng.Models.HangSanXuat>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenHang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QuocGia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SanPham)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TenHang)
            </td>
            <td>
                @Html.DisplayFor(model => item.QuocGia)
            </td>
            <td>
                @Html.DisplayFor(model => item.SanPham)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaHang">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaHang">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaHang">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
