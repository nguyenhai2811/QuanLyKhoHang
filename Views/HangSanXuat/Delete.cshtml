@model Quản_Lý_KhoHàng.Models.HangSanXuat
@{ ViewData["Title"] = "Xóa hãng sản xuất"; }
<h1>Xóa hãng sản xuất</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<p>Bạn có chắc muốn xóa hãng <strong>@Model.TenHang</strong> (@Model.QuocGia)?</p>
<form asp-action="Delete" asp-route-id="@Model.MaHang"><input type="hidden" asp-for="MaHang" /><button type="submit" class="btn btn-danger">Xóa</button> <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a></form>
