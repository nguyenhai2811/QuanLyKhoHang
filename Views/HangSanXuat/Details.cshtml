@model Quản_Lý_KhoHàng.Models.HangSanXuat
@{ ViewData["Title"] = "Chi tiết hãng sản xuất"; }
<h1>Chi tiết hãng sản xuất</h1><dl class="row"><dt class="col-sm-3">Tên hãng</dt><dd class="col-sm-9">@Model.TenHang</dd><dt class="col-sm-3">Quốc gia</dt><dd class="col-sm-9">@Model.QuocGia</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.MaHang" class="btn btn-primary">Sửa</a> <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
