@model Quản_Lý_KhoHàng.Models.NhaCungCap
@{ ViewData["Title"] = "Chi tiết nhà cung cấp"; }
<h1>Chi tiết nhà cung cấp</h1><dl class="row"><dt class="col-sm-3">Tên nhà cung cấp</dt><dd class="col-sm-9">@Model.TenNhaCungCap</dd><dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.SoDienThoai</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9">@Model.DiaChi</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.MaNhaCungCap" class="btn btn-primary">Sửa</a> <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
