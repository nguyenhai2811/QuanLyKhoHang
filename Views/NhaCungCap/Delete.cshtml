@model Quản_Lý_KhoHàng.Models.NhaCungCap
@{ ViewData["Title"] = "Xóa nhà cung cấp"; }
<h1>Xóa nhà cung cấp</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<p>Bạn có chắc muốn xóa nhà cung cấp <strong>@Model.TenNhaCungCap</strong>?</p>
<form asp-action="Delete" asp-route-id="@Model.MaNhaCungCap"><input type="hidden" asp-for="MaNhaCungCap" /><button type="submit" class="btn btn-danger">Xóa</button> <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a></form>
