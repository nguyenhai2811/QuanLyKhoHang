@model IEnumerable<Quản_Lý_KhoHàng.Models.NhaCungCap>
@{ ViewData["Title"] = "Nhà cung cấp"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Nhà cung cấp</h1><a asp-action="Create" class="btn btn-primary">Thêm nhà cung cấp</a></div>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Tên nhà cung cấp</th><th>Số điện thoại</th><th>Email</th><th>Địa chỉ</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.TenNhaCungCap</td><td>@item.SoDienThoai</td><td>@item.Email</td><td>@item.DiaChi</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.MaNhaCungCap">Sửa</a> | <a asp-action="Details" asp-route-id="@item.MaNhaCungCap">Chi tiết</a> | <a asp-action="Delete" asp-route-id="@item.MaNhaCungCap">Xóa</a></td></tr> }
</tbody></table></div>
