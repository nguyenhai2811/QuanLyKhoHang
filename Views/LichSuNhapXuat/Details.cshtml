@model Quản_Lý_KhoHàng.Models.LichSuNhapXuat
@{ ViewData["Title"] = "Chi tiết giao dịch"; }
<h1>Chi tiết giao dịch nhập xuất</h1>
<dl class="row"><dt class="col-sm-3">Mã giao dịch</dt><dd class="col-sm-9">@Model.MaGiaoDich</dd><dt class="col-sm-3">Sản phẩm</dt><dd class="col-sm-9">@Model.MaSanPhamNavigation.TenSanPham</dd><dt class="col-sm-3">Nhà cung cấp</dt><dd class="col-sm-9">@(Model.MaNhaCungCapNavigation?.TenNhaCungCap ?? "—")</dd><dt class="col-sm-3">Loại giao dịch</dt><dd class="col-sm-9">@(Model.LoaiGiaoDich == "NHAP" ? "Nhập" : "Xuất")</dd><dt class="col-sm-3">Số lượng</dt><dd class="col-sm-9">@Model.SoLuong</dd><dt class="col-sm-3">Ngày giao dịch</dt><dd class="col-sm-9">@Model.NgayGiaoDich.ToString("g")</dd><dt class="col-sm-3">Ghi chú</dt><dd class="col-sm-9">@Model.GhiChu</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.MaGiaoDich" class="btn btn-primary">Sửa</a> <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
