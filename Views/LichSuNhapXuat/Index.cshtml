@model Quản_Lý_KhoHàng.Models.PagedResult<Quản_Lý_KhoHàng.Models.LichSuNhapXuat>
@{ ViewData["Title"] = "Lịch sử nhập xuất"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Lịch sử nhập xuất</h1><a asp-action="Create" class="btn btn-primary">Thêm giao dịch</a></div>
<form asp-action="Search" method="get" class="row g-2 mb-3"><div class="col-auto"><input type="search" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Mã, sản phẩm, nhà cung cấp, loại hoặc ghi chú" /></div><div class="col-auto"><button type="submit" class="btn btn-primary">Tìm kiếm</button> <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Ngày</th><th>Sản phẩm</th><th>Loại</th><th>Số lượng</th><th>Nhà cung cấp</th><th>Ghi chú</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Items)
{
    <tr><td>@item.NgayGiaoDich.ToString("g")</td><td>@item.MaSanPhamNavigation.TenSanPham</td><td>@(item.LoaiGiaoDich == "NHAP" ? "Nhập" : "Xuất")</td><td>@item.SoLuong</td><td>@(item.MaNhaCungCapNavigation?.TenNhaCungCap ?? "—")</td><td>@item.GhiChu</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.MaGiaoDich">Sửa</a> | <a asp-action="Details" asp-route-id="@item.MaGiaoDich">Chi tiết</a> | <a asp-action="Delete" asp-route-id="@item.MaGiaoDich">Xóa</a></td></tr>
}
</tbody></table></div>


@await Html.PartialAsync("_Pagination", Model)

