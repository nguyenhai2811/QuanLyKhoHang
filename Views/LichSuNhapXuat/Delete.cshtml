@model Quản_Lý_KhoHàng.Models.LichSuNhapXuat
@{ ViewData["Title"] = "Xóa giao dịch"; }
<h1>Xóa giao dịch</h1><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<p>Bạn có chắc muốn xóa giao dịch <strong>#@Model.MaGiaoDich</strong> của sản phẩm <strong>@Model.MaSanPhamNavigation.TenSanPham</strong>?</p>
<form asp-action="Delete" asp-route-id="@Model.MaGiaoDich"><input type="hidden" asp-for="MaGiaoDich" /><button type="submit" class="btn btn-danger">Xóa</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></form>
