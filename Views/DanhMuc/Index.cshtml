@model IEnumerable<Quản_Lý_KhoHàng.Models.DanhMuc>

@{
    ViewData["Title"] = "Danh mục";
}

<h1>Danh mục</h1>

<form asp-action="Search" method="get" class="row g-2 mb-3">
    <div class="col-auto"><input type="search" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tên hoặc mô tả danh mục" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Tìm kiếm</button> <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a></div>
</form>

<p>
    <a asp-action="Create">Thêm danh mục</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenDanhMuc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TenDanhMuc)
            </td>
            <td>
                @Html.DisplayFor(model => item.MoTa)
            </td>
           
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaDanhMuc">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.MaDanhMuc">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.MaDanhMuc">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>

