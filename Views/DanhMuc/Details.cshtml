@model Quản_Lý_KhoHàng.Models.DanhMuc
@{ ViewData["Title"] = "Chi tiết danh mục"; }
<h1>Chi tiết danh mục</h1><dl class="row"><dt class="col-sm-3">Tên danh mục</dt><dd class="col-sm-9">@Model.TenDanhMuc</dd><dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.MoTa</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.MaDanhMuc" class="btn btn-primary">Sửa</a> <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
