@model PagedResult<DanhMuc>
@{ ViewData["Title"] = "Tìm kiếm danh mục"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Tìm kiếm danh mục</h1><a asp-action="Create" class="btn btn-primary">Thêm danh mục</a></div>
<form asp-action="Search" method="get" class="row g-2 mb-3"><div class="col-md-5"><input type="search" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tên, mô tả hoặc mã danh mục" /></div><div class="col-auto"><button type="submit" class="btn btn-primary">Tìm kiếm</button> <a asp-action="Search" class="btn btn-secondary">Xóa lọc</a></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Mã</th><th>Tên danh mục</th><th>Mô tả</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@item.MaDanhMuc</td><td>@item.TenDanhMuc</td><td>@item.MoTa</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.MaDanhMuc">Sửa</a> | <a asp-action="Details" asp-route-id="@item.MaDanhMuc">Chi tiết</a> | <a asp-action="Delete" asp-route-id="@item.MaDanhMuc">Xóa</a></td></tr> }
</tbody></table></div>

@await Html.PartialAsync("_Pagination", Model)

