@model Quản_Lý_KhoHàng.Models.DanhMuc

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h1>Xóa danh mục</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<h3>Bạn có chắc muốn xóa danh mục này?</h3>
<div>

    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TenDanhMuc)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenDanhMuc)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MoTa)
        </dd>
    </dl>
   
    <form asp-action="Delete" asp-route-id="@Model.MaDanhMuc">
        <input type="hidden" asp-for="MaDanhMuc" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
